############################################
# 줄바꿈과 파일 종류 기준 (마스터본)
#
#   저장소 안(blob)은 LF 로 통일하고, 작업본은 아래 규칙대로 꺼낸다.
#   이 파일이 core.autocrlf(기계 설정)보다 우선하므로 어느 기계에서 clone 해도 같게
#   동작한다. autocrlf 는 Git for Windows 설치 마법사가 기본으로 넣는 값이라 기계마다
#   다를 수 있는데, 여기 적어 두면 그 차이에 휘둘리지 않는다.
#
#   기준이 없으면 파일이 어떻게 만들어졌느냐에 따라 줄바꿈이 제각각이 되고, 편집기가
#   파일을 열 때마다 git 이 변경으로 잡는다.
#
#   한 줄에 무늬 하나만 적을 수 있다. 여럿을 늘어놓으면 뒤엣것을 속성 이름으로 읽는다.
#
#   지금 쓰지 않는 갈래도 미리 적어 둔다. 나중에 그 파일이 처음 들어오는 날,
#   기준이 없어 잘못 담기는 것보다 낫다.

############################################
# 1) 기본 - git 에 맡긴다
#
#   text=auto 는 파일 앞머리에 NUL 바이트가 있는지 보고 글월인지 덩이인지 가른다.
#   글월이면 저장소 안을 LF 로 맞추고, 덩이면 손대지 않는다. 소스 코드·설정·문서는
#   거의 다 여기서 옳게 걸리므로 확장자를 낱낱이 적을 까닭이 없다.
#   아래 2)3) 은 이 판단이 틀리거나, 맞더라도 꺼내는 모습까지 정해야 하는 것들이다.
#
#   가르는 솜씨는 꽤 좋다. 같은 .asset 이라도 %YAML 로 여는 것은 글월로, UnityFS 로
#   여는 것은 덩이로 옳게 보았다(실측). 그러니 프로젝트마다 성격이 갈리는 확장자는
#   여기 맡기는 편이 낫다. 다만 auto 가 정하는 것은 '글월이냐 덩이냐' 까지이고,
#   글월을 어떤 줄바꿈으로 꺼낼지는 정하지 못한다 - 그것이 2) 와 5) 가 있는 까닭이다.

* text=auto

# 겉보기와 달리 글월인 것 - 확장자만 보면 그림·덩이 같아 오해하기 쉽다
*.svg       text
*.pem       text
*.crt       text
*.cer       text
*.md5       text
*.sha1      text
*.sha256    text

############################################
# 2) 줄바꿈을 못 박는 것
#
#   여기 적힌 것들은 줄바꿈이 틀리면 '보기 나쁜' 데서 그치지 않고 실제로 동작하지 않는다.
#   그래서 기계 설정에 맡기지 않고 eol 로 못 박는다.

# 셸 스크립트 - 반드시 LF
#   첫 줄 #!/bin/bash 뒤에 CR 이 붙으면 셸이 그것까지 실행 파일 이름으로 읽어
#   "bad interpreter: /bin/bash^M" 로 죽는다. 윈도우에서 작업해도 LF 로 꺼낸다.
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.fish      text eol=lf

# Makefile - 반드시 LF
#   make 는 명령 줄이 탭으로 시작하는지 따지는데, CR 이 끼면 줄 끝이 어긋나
#   "missing separator" 를 낸다.
*.mk        text eol=lf
Makefile    text eol=lf
makefile    text eol=lf
GNUmakefile text eol=lf

# 리눅스 안에서 도는 것 - 반드시 LF
#   윈도우에서 지어도 컨테이너·서버 안에서는 리눅스가 읽는다. CR 이 붙으면
#   명령 이름이나 값 끝에 딸려 들어가 엉뚱하게 동작한다.
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
*.service   text eol=lf
*.socket    text eol=lf
*.desktop   text eol=lf

# 윈도우 배치·PowerShell - 반드시 CRLF
#   cmd.exe 는 줄을 CRLF 로 끊는 것을 전제한다. LF 뿐이면 goto 와 여러 줄 블록에서
#   엉뚱한 자리로 뛰거나 마지막 줄을 흘린다.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.vbs       text eol=crlf
*.wsf       text eol=crlf

# 레지스트리 파일 - 반드시 CRLF
#   regedit 이 CRLF 를 전제하고 읽는다. LF 뿐이면 가져오기가 통째로 실패한다.
*.reg       text eol=crlf

# 자막 - CRLF
#   SubRip(.srt) 규격이 CRLF 로 적게 되어 있다. LF 로도 읽는 재생기가 많지만
#   규격을 따르는 편이 안전하다.
*.srt       text eol=crlf

############################################
# 3) 손대면 깨지는 것 - 변환하지 않는다
#
#   아래는 모두 바이트 하나하나가 뜻을 가지는 파일이다. 그 안에 우연히 0x0A(LF)나
#   0x0D(CR) 값이 들어 있을 수 있는데, git 이 그것을 줄바꿈으로 알고 바꾸면 내용이
#   망가진다. text=auto 가 대개 알아서 피하지만, NUL 이 앞머리에 없는 묶음은
#   글월로 오해할 여지가 있어 여기 못 박는다.

